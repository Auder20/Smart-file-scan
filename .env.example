# Smart File Organizer Configuration
# ==================================

# Default scan root path shown in UI on first launch
# Examples:
#   Windows: C:\Users
#   Linux:   /home
#   macOS:   /Users/username
HOST_SCAN_PATH=/home

# Backend server configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Redis configuration (optional - used for caching and session storage)
# Leave empty to disable Redis features
REDIS_HOST=localhost
REDIS_PORT=6379

# Docker mode configuration
# Leave empty for native mode (running directly on host OS)
# Set to /host for Docker mode (containerized environment)
HOST_ROOT=

# Additional optional settings
# -----------------------------

# Maximum scan depth (default: 20)
# SCAN_MAX_DEPTH=20

# Include hidden files in scans (default: false)
# SCAN_INCLUDE_HIDDEN=false

# WebSocket timeout in seconds (default: 300)
# WS_TIMEOUT=300

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
