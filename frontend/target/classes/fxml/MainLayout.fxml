<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartfileorganizer.controllers.MainController"
            prefWidth="1000" prefHeight="660" minWidth="800" minHeight="540"
            style="-fx-background-color: #0D0F12;">

    <!-- ═══ SIDEBAR ══════════════════════════════════════════════════ -->
    <VBox fx:id="sidebar" prefWidth="230"
          style="-fx-background-color: #13161B;
                 -fx-border-color: #2A2F3A;
                 -fx-border-width: 0 1 0 0;
                 -fx-padding: 0;
                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.6),16,0,4,0);"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">

        <!-- Accent top bar -->
      <Pane prefHeight="2" maxHeight="2" style="-fx-background-color: #38BDF8; -fx-opacity: 0.9;" VBox.vgrow="NEVER"/>

        <!-- Logo zone -->
        <VBox spacing="3"
              style="-fx-padding: 22 18 20 18;
                     -fx-border-color: transparent transparent #1E2129 transparent;
                     -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Rectangle width="6" height="22" arcWidth="3" arcHeight="3" fill="#38BDF8"
                           style="-fx-effect: dropshadow(gaussian,rgba(56,189,248,0.6),6,0,0,0);"/>
                <VBox spacing="1">
                    <Label text="smart-organizer"
                           style="-fx-text-fill: #EDF0F5;
                                  -fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-font-family: 'JetBrains Mono','Fira Code','Consolas',monospace;"/>
                    <Label text="file analysis tool"
                           style="-fx-text-fill: #2A2F3A;
                                  -fx-font-size: 10px;
                                  -fx-font-family: 'JetBrains Mono','Fira Code','Consolas',monospace;"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Nav section label -->
        <Label text="// navigation"
               style="-fx-text-fill: #2A2F3A;
                      -fx-font-size: 10px;
                      -fx-font-weight: bold;
                      -fx-font-family: 'JetBrains Mono','Fira Code','Consolas',monospace;
                      -fx-padding: 14 18 6 18;"/>

        <!-- Nav buttons -->
        <VBox spacing="2" style="-fx-padding: 0 10;">
            <Button fx:id="btnDashboard" text="▸  dashboard"
                    maxWidth="Infinity" styleClass="nav-btn" onAction="#showDashboard"/>
            <Button fx:id="btnScanner" text="▸  scan"
                    maxWidth="Infinity" styleClass="nav-btn" onAction="#showScanner"/>
            <Button fx:id="btnDuplicates" text="▸  duplicates"
                    maxWidth="Infinity" styleClass="nav-btn" onAction="#showDuplicates"/>
            <Button fx:id="btnStats" text="▸  stats"
                    maxWidth="Infinity" styleClass="nav-btn" onAction="#showStats"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Footer zone -->
        <VBox spacing="6"
              style="-fx-padding: 14 18;
                     -fx-border-color: #1E2129 transparent transparent transparent;
                     -fx-border-width: 1 0 0 0;">
            <Label text="v1.0.0"
                   style="-fx-text-fill: #2A2F3A;
                          -fx-font-size: 10px;
                          -fx-font-family: 'JetBrains Mono','Fira Code','Consolas',monospace;"/>
        </VBox>

    </VBox>

    <!-- ═══ CONTENT ══════════════════════════════════════════════════ -->
    <StackPane fx:id="contentArea"
               style="-fx-background-color: #0D0F12;"
               AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="230" AnchorPane.rightAnchor="0"/>

</AnchorPane>
