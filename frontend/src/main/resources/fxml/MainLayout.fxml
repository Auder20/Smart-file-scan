<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartfileorganizer.controllers.MainController"
            prefWidth="1100" prefHeight="700" minWidth="860" minHeight="580"
            style="-fx-background-color: #1E1E1E;">

    <!-- SIDEBAR -->
    <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="220"
          style="-fx-background-color: #141414; -fx-border-color: #2D2D30; -fx-border-width: 0 1 0 0; -fx-padding: 20 12;"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">

        <!-- Logo -->
        <VBox spacing="2" style="-fx-padding: 4 8 24 8;">
            <Label text="⚡ Smart Organizer"
                   style="-fx-text-fill: #E8E8E8; -fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label text="File Analysis Tool"
                   style="-fx-text-fill: #3E3E42; -fx-font-size: 10px;"/>
        </VBox>

        <!-- Section label -->
        <Label text="NAVIGATION"
               style="-fx-text-fill: #3E3E42; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 0 8 8 8;"/>

        <!-- Nav buttons -->
        <Button fx:id="btnDashboard"  text="📊   Dashboard"
                maxWidth="Infinity" styleClass="nav-btn" onAction="#showDashboard"/>
        <Button fx:id="btnScanner"    text="🔍   Escanear"
                maxWidth="Infinity" styleClass="nav-btn" onAction="#showScanner"/>
        <Button fx:id="btnDuplicates" text="📁   Duplicados"
                maxWidth="Infinity" styleClass="nav-btn" onAction="#showDuplicates"/>
        <Button fx:id="btnStats"      text="📈   Estadísticas"
                maxWidth="Infinity" styleClass="nav-btn" onAction="#showStats"/>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Footer -->
        <VBox spacing="4" style="-fx-padding: 8;">
            <Separator style="-fx-opacity: 0.3;"/>
            <Label text="v1.0.0  •  Smart File Organizer"
                   style="-fx-text-fill: #3E3E42; -fx-font-size: 10px; -fx-padding: 4 0 0 0;"/>
        </VBox>
    </VBox>

    <!-- CONTENT -->
    <StackPane fx:id="contentArea"
               style="-fx-background-color: #1E1E1E;"
               AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="220" AnchorPane.rightAnchor="0"/>

</AnchorPane>
