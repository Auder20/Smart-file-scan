<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
  FIX: versión anterior usaba estilos del sistema (tema claro por defecto),
  inconsistente con el resto de la app en modo oscuro.
  Ahora aplica el mismo fondo y colores del theme principal.

  FIX: agrega controles de paginación (btnPrevPage / btnNextPage / lblPageInfo)
  que FilesViewController.java necesita para navegar entre páginas.
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartfileorganizer.controllers.FilesViewController"
      spacing="12"
      style="-fx-background-color: #1E1E1E; -fx-padding: 20;">

  <!-- Header -->
  <HBox spacing="12" alignment="CENTER_LEFT">
    <Label fx:id="lblScanInfo" text="Información del scan"
           style="-fx-text-fill: #E8E8E8; -fx-font-size: 14px; -fx-font-weight: bold;"/>
    <Region HBox.hgrow="ALWAYS"/>
    <ProgressBar fx:id="progressBar" visible="false" prefWidth="180"
                 style="-fx-pref-height: 6px;"/>
  </HBox>

  <!-- Filters -->
  <HBox spacing="10" alignment="CENTER_LEFT"
        style="-fx-background-color: #252526; -fx-background-radius: 8;
               -fx-border-color: #2D2D30; -fx-border-width: 1; -fx-border-radius: 8;
               -fx-padding: 10 14;">
    <TextField fx:id="txtSearch" prefWidth="260"
               promptText="Buscar por nombre o ruta…"
               style="-fx-background-color: #1A1A1A; -fx-text-fill: #E8E8E8;
                      -fx-prompt-text-fill: #4A4A50; -fx-background-radius: 6;
                      -fx-border-color: #3E3E42; -fx-border-width: 1;
                      -fx-border-radius: 6; -fx-padding: 6 10;"/>
    <ComboBox fx:id="cmbCategory" prefWidth="160"
              style="-fx-background-color: #1A1A1A; -fx-border-color: #3E3E42;
                     -fx-border-width: 1; -fx-background-radius: 6; -fx-border-radius: 6;"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Button text="Limpiar filtros" onAction="#clearFilters"
            style="-fx-background-color: #2D2D30; -fx-text-fill: #9A9A9F;
                   -fx-background-radius: 6; -fx-border-radius: 6;
                   -fx-border-color: #3E3E42; -fx-border-width: 1; -fx-padding: 6 14;"/>
  </HBox>

  <!-- Stats -->
  <HBox spacing="24" alignment="CENTER_LEFT">
    <Label fx:id="lblTotalFiles" text="Archivos: 0"
           style="-fx-text-fill: #4B9EFF; -fx-font-size: 13px; -fx-font-weight: bold;"/>
    <Label fx:id="lblTotalSize" text="Tamaño total: 0 B"
           style="-fx-text-fill: #3FB68E; -fx-font-size: 13px; -fx-font-weight: bold;"/>
  </HBox>

  <!-- Files table -->
  <TableView fx:id="filesTable" VBox.vgrow="ALWAYS" prefHeight="420"
             style="-fx-background-color: #252526; -fx-border-color: #2D2D30;
                    -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;">
    <columns>
      <TableColumn fx:id="colName"      text="Nombre"     prefWidth="200"/>
      <TableColumn fx:id="colPath"      text="Ruta"       prefWidth="280"/>
      <TableColumn fx:id="colSize"      text="Tamaño"     prefWidth="90"/>
      <TableColumn fx:id="colExtension" text="Extensión"  prefWidth="80"/>
      <TableColumn fx:id="colCategory"  text="Categoría"  prefWidth="100"/>
      <TableColumn fx:id="colModified"  text="Modificado" prefWidth="150"/>
    </columns>
    <placeholder>
      <Label text="No hay archivos para mostrar."
             style="-fx-text-fill: #4A4A50; -fx-font-size: 12px;"/>
    </placeholder>
  </TableView>

  <!-- Pagination -->
  <HBox spacing="10" alignment="CENTER"
        style="-fx-background-color: #252526; -fx-background-radius: 6;
               -fx-border-color: #2D2D30; -fx-border-width: 1; -fx-border-radius: 6;
               -fx-padding: 8 14;">
    <Button fx:id="btnPrevPage" text="← Anterior" onAction="#prevPage"
            disable="true"
            style="-fx-background-color: #2D2D30; -fx-text-fill: #9A9A9F;
                   -fx-background-radius: 6; -fx-border-radius: 6;
                   -fx-border-color: #3E3E42; -fx-border-width: 1; -fx-padding: 6 14;"/>
    <Label fx:id="lblPageInfo" text="Página 1 / 1"
           style="-fx-text-fill: #6E6E75; -fx-font-size: 12px;"/>
    <Button fx:id="btnNextPage" text="Siguiente →" onAction="#nextPage"
            disable="true"
            style="-fx-background-color: #2D2D30; -fx-text-fill: #9A9A9F;
                   -fx-background-radius: 6; -fx-border-radius: 6;
                   -fx-border-color: #3E3E42; -fx-border-width: 1; -fx-padding: 6 14;"/>
  </HBox>

  <!-- Actions -->
  <HBox spacing="10" alignment="CENTER_RIGHT">
    <Button text="Exportar CSV"  onAction="#exportCsv"
            style="-fx-background-color: #2D2D30; -fx-text-fill: #9A9A9F;
                   -fx-background-radius: 6; -fx-border-radius: 6;
                   -fx-border-color: #3E3E42; -fx-border-width: 1; -fx-padding: 6 14;"/>
    <Button text="Exportar JSON" onAction="#exportJson"
            style="-fx-background-color: #2D2D30; -fx-text-fill: #9A9A9F;
                   -fx-background-radius: 6; -fx-border-radius: 6;
                   -fx-border-color: #3E3E42; -fx-border-width: 1; -fx-padding: 6 14;"/>
    <Button text="Cerrar" onAction="#close"
            style="-fx-background-color: #4B9EFF; -fx-text-fill: #0D1117;
                   -fx-font-weight: bold; -fx-background-radius: 6;
                   -fx-border-radius: 6; -fx-padding: 6 18;"/>
  </HBox>

</VBox>
