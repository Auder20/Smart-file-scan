<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.smartfileorganizer.controllers.ScannerController"
      spacing="20" style="-fx-padding: 30; -fx-background-color: #F8FAFC;">

    <!-- Header -->
    <HBox spacing="20" alignment="CENTER_LEFT">
        <Label text="🔍 Escaneo de Archivos" 
               style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnRefresh" text="🔄 Actualizar" styleClass="secondary-btn"/>
    </HBox>

    <!-- Selección de Carpeta -->
    <VBox spacing="10" styleClass="card">
        <Label text="Seleccionar Carpeta" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtFolderPath" prefWidth="400" promptText="Ruta de la carpeta a escanear..."
                       style="-fx-font-size: 14;"/>
            <Button fx:id="btnBrowse" text="📁 Examinar" styleClass="primary-btn"/>
        </HBox>
        
        <!-- Opciones de escaneo -->
        <GridPane hgap="15" vgap="10">
            <Label text="Profundidad máxima:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                   style="-fx-text-fill: #64748B;"/>
            <Spinner fx:id="spinnerMaxDepth" min="1" max="50" initialValue="20" 
                    GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="100"/>
            
            <CheckBox fx:id="chkIncludeHidden" text="Incluir archivos ocultos" 
                     GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2"
                     style="-fx-text-fill: #64748B;"/>
        </GridPane>
        
        <HBox spacing="10">
            <Button fx:id="btnStartScan" text="🚀 Iniciar Escaneo" styleClass="primary-btn" 
                    disable="true" prefWidth="150"/>
            <Button fx:id="btnStopScan" text="⏹️ Detener" styleClass="danger-btn" 
                    disable="true" prefWidth="100"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblStatus" text="Listo" style="-fx-text-fill: #64748B;"/>
        </HBox>
    </VBox>

    <!-- Progreso -->
    <VBox fx:id="progressSection" spacing="10" visible="false" managed="false">
        <Label text="Progreso del Escaneo" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <ProgressBar fx:id="progressBar" prefWidth="Infinity" progress="0" styleClass="progress-bar"/>
        <HBox spacing="20">
            <Label fx:id="lblProgress" text="0%" style="-fx-text-fill: #64748B;"/>
            <Label fx:id="lblFilesFound" text="0 archivos encontrados" style="-fx-text-fill: #64748B;"/>
            <Label fx:id="lblCurrentDir" text="" style="-fx-text-fill: #64748B;"/>
        </HBox>
    </VBox>

    <!-- Resultados -->
    <VBox fx:id="resultsSection" spacing="10" visible="false" managed="false">
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label text="Resultados" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnViewFiles" text="📋 Ver Archivos" styleClass="secondary-btn"/>
            <Button fx:id="btnExport" text="💾 Exportar" styleClass="secondary-btn"/>
        </HBox>
        
        <!-- Estadísticas rápidas -->
        <HBox spacing="20" styleClass="stats-container">
            <VBox spacing="5" styleClass="stat-card">
                <Label fx:id="lblTotalFiles" text="0" styleClass="stat-number"/>
                <Label text="Archivos Totales" styleClass="stat-label"/>
            </VBox>
            <VBox spacing="5" styleClass="stat-card">
                <Label fx:id="lblTotalSize" text="0 MB" styleClass="stat-number"/>
                <Label text="Tamaño Total" styleClass="stat-label"/>
            </VBox>
            <VBox spacing="5" styleClass="stat-card">
                <Label fx:id="lblScanTime" text="0s" styleClass="stat-number"/>
                <Label text="Duración" styleClass="stat-label"/>
            </VBox>
            <VBox spacing="5" styleClass="stat-card">
                <Label fx:id="lblScanId" text="" styleClass="stat-number"/>
                <Label text="ID de Escaneo" styleClass="stat-label"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Lista de Escaneos Previos -->
    <VBox spacing="10">
        <Label text="Escaneos Previos" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <TableView fx:id="tableScans" prefHeight="200" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colScanId" text="ID" prefWidth="80"/>
                <TableColumn fx:id="colStatus" text="Estado" prefWidth="100"/>
                <TableColumn fx:id="colFiles" text="Archivos" prefWidth="100"/>
                <TableColumn fx:id="colDate" text="Fecha" prefWidth="150"/>
                <TableColumn fx:id="colActions" text="Acciones" prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
